{
    "name": "service-front",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "dev:https": "next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
        "build": "next build",
        "start": "next start",
        "lint": "biome lint .",
        "lint:fix": "biome lint . --write",
        "lint:markup": "markuplint \"./src/**/*.{jsx,tsx}\"",
        "format:check": "biome format .",
        "format": "biome format . --write",
        "check": "biome check .",
        "check:fix": "biome check . --write --unsafe",
        "type-check": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:e2e": "playwright test",
        "test:all": "npm run test && npm run test:e2e",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "validate": "npm run type-check && npm run lint && npm run test"
    },
    "dependencies": {
        "@google/genai": "^1.49.0",
        "@repo/supabase": "*",
        "@repo/ui": "*",
        "@tanstack/react-query": "^5.62.0",
        "clsx": "^2.1.1",
        "lucide-react": "^1.16.0",
        "next": "^16.2.1",
        "nodemailer": "^8.0.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.54.2",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "yup": "^1.6.1",
        "zustand": "^5.0.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@hookform/resolvers": "^4.1.3",
        "@markuplint/jsx-parser": "^4.18.3",
        "@markuplint/react-spec": "^4.18.0",
        "@playwright/test": "^1.56.1",
        "@storybook/addon-a11y": "^10.3.3",
        "@storybook/addon-links": "^10.3.3",
        "@storybook/nextjs": "^10.3.3",
        "@tailwindcss/postcss": "^4",
        "@tanstack/react-query-devtools": "^5.62.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@types/jest": "^29.5.14",
        "@types/node": "22.10.2",
        "@types/nodemailer": "^7.0.11",
        "@types/react": "19.0.2",
        "@types/react-dom": "19.0.2",
        "@vercel/speed-insights": "^1.2.0",
        "jest": "^29.7.0",
        "jest-fixed-jsdom": "^0.0.9",
        "markuplint": "^4.18.3",
        "msw": "^2.7.0",
        "msw-storybook-addon": "^2.0.4",
        "shadcn": "^4.7.0",
        "storybook": "^10.3.3",
        "tailwindcss": "^4",
        "ts-jest": "^29.2.5",
        "ts-node": "10.9.2",
        "typescript": "5.7.2"
    },
    "volta": {
        "node": "22.12.0",
        "npm": "11.0.0"
    },
    "engines": {
        "node": ">=22.12.0 <23.0.0",
        "npm": ">=11.0.0"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
