{
  "extends": [
    "markuplint:recommended-react"
  ],
  "parser": {
    ".[jt]sx$": "@markuplint/jsx-parser"
  },
  "specs": {
    ".[jt]sx$": "@markuplint/react-spec"
  },
  "rules": {
    "no-hard-code-id": false
  },
  "overrides": {
    "**/*.{test,spec,stories}.{jsx,tsx}": {
      "rules": {
        "id-duplication": false
      }
    },
    "**/components/server/{TrendChartCard,DiveTrends}/*.{jsx,tsx}": {
      "rules": {
        "heading-levels": false
      }
    },
    "**/components/chart/LineChart/LineChart.{jsx,tsx}": {
      "rules": {
        "permitted-contents": false
      }
    }
  }
}