-- ========================================
-- 開発用シードデータ（テンプレート）
--
-- これは envsubst で展開する元ファイル。
-- ${...} プレースホルダはルートの .env.local の値で置換され、
-- 生成物 supabase/seed.sql は supabase db reset 時に自動で流れる。
--
-- 生成・適用は `make supabase-reset` で行う:
--   1. .env.local を読み込み
--   2. envsubst で ${...} を展開して supabase/seed.sql を生成
--   3. supabase db reset を実行
--
-- 投入内容:
--   - テストユーザー 1 名（auth.users 経由 → トリガで public.users / public.user_details 自動挿入）
--   - ダイビングログ 5 件
--
-- 本番では使用しない（local development 専用）
-- ========================================

-- ========================================
-- 冪等性: 再実行できるようにテストユーザーを掃除
-- public.users への ON DELETE CASCADE で
-- public.user_details / public.dives も連動削除される
-- ========================================
delete from auth.users where email = '${TEST_USER_EMAIL}';

-- ========================================
-- テストユーザー
--   email   : ${TEST_USER_EMAIL}
--   password: .env.local の TEST_USER_PASSWORD
--
-- auth.users への INSERT で on_auth_user_created トリガが起動し、
-- raw_user_meta_data の値をもとに public.users / public.user_details が
-- 自動挿入される（user_details の必須項目はここで埋める）
-- ========================================
insert into auth.users (
    instance_id,
    id,
    aud,
    role,
    email,
    encrypted_password,
    email_confirmed_at,
    raw_app_meta_data,
    raw_user_meta_data,
    confirmation_token,
    email_change,
    email_change_token_new,
    recovery_token,
    created_at,
    updated_at
) values (
    '00000000-0000-0000-0000-000000000000',
    '${TEST_USER_ID}',
    'authenticated',
    'authenticated',
    '${TEST_USER_EMAIL}',
    crypt('${TEST_USER_PASSWORD}', gen_salt('bf')),
    now(),
    '{"provider": "email", "providers": ["email"]}'::jsonb,
    jsonb_build_object(
        'last_name', '田中',
        'first_name', '太郎',
        'last_name_romaji', 'Tanaka',
        'first_name_romaji', 'Taro',
        'nickname', 'たろう',
        'birth_on', '1990-05-15',
        'gender', 'male',
        'height_cm', '170',
        'weight_kg', '65'
    ),
    '',
    '',
    '',
    '',
    now(),
    now()
);

-- email / password 認証で必要な identity レコード
-- 新しめの Supabase は auth.identities ベースで認証するため必須
insert into auth.identities (
    id,
    user_id,
    identity_data,
    provider,
    provider_id,
    last_sign_in_at,
    created_at,
    updated_at
) values (
    gen_random_uuid(),
    '${TEST_USER_ID}',
    jsonb_build_object(
        'sub', '${TEST_USER_ID}',
        'email', '${TEST_USER_EMAIL}',
        'email_verified', true,
        'phone_verified', false
    ),
    'email',
    '${TEST_USER_ID}',
    now(),
    now(),
    now()
);

